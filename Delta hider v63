-- Hide Delta + Tap bottom-left corner to show/hide

local gethui = gethui or get_hidden_gui or function()
    return game:GetService("CoreGui")
end

local hidden = true

local function isDeltaGui(gui)
    if not gui:IsA("ScreenGui") then return false end

    local img = gui:FindFirstChildOfClass("ImageButton") or gui:FindFirstChildOfClass("ImageLabel")
    if img then
        local id = tostring(img.Image):lower()
        if id:find("logo") or id:find("ninja") or id:find("delta") or id:find("hood") then
            return true
        end
    end

    if gui:FindFirstChild("Console")
    or gui:FindFirstChild("Executor")
    or gui:FindFirstChild("ScriptHub")
    or gui:FindFirstChild("IsTween")
    or gui:FindFirstChild("Home") then
        return true
    end

    return false
end

local function hideDelta()
    for _, gui in pairs(gethui():GetChildren()) do
        if isDeltaGui(gui) then
            gui.Enabled = false
        end
    end
    hidden = true
end

local function showDelta()
    for _, gui in pairs(gethui():GetChildren()) do
        if isDeltaGui(gui) then
            gui.Enabled = true
        end
    end
    hidden = false
end

-- Invisible button covering the bottom-left corner
local function createCornerButton()
    if gethui():FindFirstChild("DeltaCornerButton") then return end

    local gui = Instance.new("ScreenGui")
    gui.Name = "DeltaCornerButton"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = gethui()

    local btn = Instance.new("TextButton")
    btn.Name = "Corner"
    btn.Size = UDim2.new(0, 80, 0, 80)               -- size of the tap zone
    btn.Position = UDim2.new(0, 0, 1, -80)            -- bottom-left corner
    btn.BackgroundTransparency = 1                   -- fully invisible
    btn.Text = ""
    btn.ZIndex = 10
    btn.Parent = gui

    btn.MouseButton1Click:Connect(function()
        if hidden then
            showDelta()
            print("Delta shown (bottom-left)")
        else
            hideDelta()
            print("Delta hidden (bottom-left)")
        end
    end)
end

-- Start hidden
hideDelta()
createCornerButton()

-- Keep forcing hide while needed
task.spawn(function()
    while true do
        task.wait(0.35)
        if hidden then
            hideDelta()
        end
    end
end)

print("Loaded → Tap bottom-left corner to show/hide Delta")
